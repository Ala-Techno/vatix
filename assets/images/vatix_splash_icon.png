<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="1024" height="1024">
  <defs>
    <filter id="softShadow" x="-15%" y="-15%" width="130%" height="130%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#0D2847" flood-opacity="0.18"/>
    </filter>
  </defs>

  <!-- Safe Zone: Centered within 680x680 circle (from x=172, y=172 to x=852, y=852) -->
  <g transform="translate(512, 512)">
    <!-- Rounded Square Badge -->
    <rect x="-240" y="-240" width="480" height="480" rx="115" ry="115" fill="#102C4E" filter="url(#softShadow)"/>

    <!-- Network Node Icon -->
    <g stroke="#FFFFFF" stroke-width="26" stroke-linecap="round">
      <!-- Top Node Line -->
      <line x1="0" y1="0" x2="0" y2="-115"/>
      <!-- Top-Right Node Line -->
      <line x1="0" y1="0" x2="109" y2="-35"/>
      <!-- Bottom-Right Node Line -->
      <line x1="0" y1="0" x2="68" y2="93"/>
      <!-- Bottom-Left Node Line -->
      <line x1="0" y1="0" x2="-68" y2="93"/>
      <!-- Top-Left Node Line -->
      <line x1="0" y1="0" x2="-109" y2="-35"/>
    </g>

    <!-- Nodes Circles -->
    <g fill="#FFFFFF">
      <!-- Center Hub -->
      <circle cx="0" cy="0" r="44"/>
      <!-- Outer 5 Nodes -->
      <circle cx="0" cy="-115" r="28"/>
      <circle cx="109" cy="-35" r="28"/>
      <circle cx="68" cy="93" r="28"/>
      <circle cx="-68" cy="93" r="28"/>
      <circle cx="-109" cy="-35" r="28"/>
    </g>
  </g>
</svg>