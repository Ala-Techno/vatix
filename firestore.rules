rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ─────────────────────────────────────────────
    // Common Helper Functions
    // ─────────────────────────────────────────────

    // Is the user signed in?
    function signedIn() {
      return request.auth != null;
    }

    // Get current user's document from users collection
    function me() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }

    // Is the user a wholesaler?
    function isWholesaler() {
      return signedIn() && me().role == 'wholesaler';
    }

    // Is the user an active retailer?
    function isActiveRetailer() {
      return signedIn() && me().role == 'retailer' && me().status == 'active';
    }

    // Is the currency valid in the system?
    function currencyOk(c) {
      return c in ['YER', 'SAR', 'USD'];
    }

    // ─────────────────────────────────────────────
    // invites/{code} — Invite Codes
    // ─────────────────────────────────────────────
    
   match /invites/{code} {

      // Read single code by get is allowed for verification during registration
      allow get: if true;

      // [E1] Wholesaler can list only their own invite codes to view and rotate
      allow list: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid;

      // Wholesaler can create or update only their own invite codes
      allow create, update: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // users/{uid} — User Profiles
    // ─────────────────────────────────────────────
    match /users/{uid} {

      // User reads own profile, or wholesaler reads their retailers, or retailer reads their wholesaler
      allow read: if signedIn()
        && (
          uid == request.auth.uid
          || resource.data.wholesalerId == request.auth.uid
          || uid == me().wholesalerId
        );

      // Register new retailer only — under strict conditions:
      // 1) Document ID matches auth UID
      // 2) Role is retailer only (cannot register as wholesaler)
      // 3) Initial status is pending (cannot self-activate)
      // 4) Invite code exists and is active
      // 5) wholesalerId in request matches invite code document
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'retailer'
        && request.resource.data.status == 'pending'
        && exists(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode))
        && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.isActive == true
        && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.wholesalerId
             == request.resource.data.wholesalerId;

      // User updates only their personal profile fields (cannot touch role, wholesaler, or status)
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['businessName','ownerName','phone','city','address','avatarUrl','updatedAt']);

      // Wholesaler approves or blocks their own affiliated retailer only
      // modifying only status and updatedAt
      allow update: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid
        && request.resource.data.status in ['active','blocked']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','updatedAt']);

      // User documents cannot be deleted
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // products/{id} — Products
    // ─────────────────────────────────────────────
    match /products/{id} {
      // Wholesaler reads their products; active retailer reads their wholesaler's products
      allow read: if isWholesaler() && resource.data.wholesalerId == request.auth.uid
                  || isActiveRetailer() && resource.data.wholesalerId == me().wholesalerId;

      // Wholesaler creates product under their ID with valid currency
      allow create: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid
        && currencyOk(request.resource.data.currency);

      // Wholesaler updates or deletes their own products
      allow update, delete: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid;

      // Active retailer can update stockQuantity and availability upon order placement
      allow update: if isActiveRetailer()
        && resource.data.wholesalerId == me().wholesalerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stockQuantity', 'isAvailable', 'updatedAt']);
    }

    // ─────────────────────────────────────────────
    // orders/{id} — Orders
    // ─────────────────────────────────────────────
    match /orders/{id} {
      // Order readable by retailer who placed it or recipient wholesaler
      allow read: if signedIn() && (
        resource.data.retailerId == request.auth.uid
        || resource.data.wholesalerId == request.auth.uid
      );

      // Active retailer creates order:
      // 1) retailerId matches auth UID
      // 2) wholesalerId matches retailer's wholesaler
      // 3) Initial status is pending
      allow create: if isActiveRetailer()
        && request.resource.data.retailerId == request.auth.uid
        && request.resource.data.wholesalerId == me().wholesalerId
        && request.resource.data.status == 'pending';

      // Wholesaler updates:
      // 1) pending -> approved (with paymentType credit or cash)
      // 2) pending -> rejected (with rejectionReason)
      // 3) approved -> delivered
      // restricted by affectedKeys
      allow update: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid
        && ((resource.data.status == 'pending' && request.resource.data.status == 'approved'
               && request.resource.data.paymentType in ['credit', 'cash'])
         || (resource.data.status == 'pending' && request.resource.data.status == 'rejected')
         || (resource.data.status == 'approved' && request.resource.data.status == 'delivered'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paymentType', 'updatedAt', 'approvedAt', 'deliveredAt', 'rejectionReason']);

      // Retailer cancels pending order only, modifying only status and updatedAt
      allow update: if signedIn()
        && resource.data.retailerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      // Orders cannot be deleted
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // ledger/{id} — Financial Ledger Entries
    // ─────────────────────────────────────────────
    match /ledger/{id} {
      // Ledger entry readable by relevant retailer or wholesaler
      allow read: if signedIn() && (
        resource.data.retailerId == request.auth.uid
        || resource.data.wholesalerId == request.auth.uid
      );

      // Wholesaler creates ledger entry for affiliated retailer with strict field validation
      allow create: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid
        && request.resource.data.retailerId is string
        && request.resource.data.retailerId != ''
        && request.resource.data.type in ['DEBT', 'PAYMENT']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && currencyOk(request.resource.data.currency)
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(db)/documents/users/$(request.resource.data.retailerId)).data.wholesalerId == request.auth.uid;

      // Immutable financial ledger: update or delete is strictly prohibited
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // accounts/{id} — Retailer Accounts & Balances
    // ─────────────────────────────────────────────
    match /accounts/{id} {
      // Account readable by relevant retailer or wholesaler
      allow read: if signedIn() && (
        resource.data.retailerId == request.auth.uid
        || resource.data.wholesalerId == request.auth.uid
      );

      // Wholesaler updates or merges balances for their affiliated retailers
      allow write: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid
        && request.resource.data.retailerId is string
        && get(/databases/$(db)/documents/users/$(request.resource.data.retailerId)).data.wholesalerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // Default fallback — deny anything not explicitly allowed
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}

