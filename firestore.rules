rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ─────────────────────────────────────────────
    // دوال مساعدة مشتركة
    // ─────────────────────────────────────────────

    // هل المستخدم مسجّل دخوله؟
    function signedIn() {
      return request.auth != null;
    }

    // جلب مستند المستخدم الحالي من users
    function me() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }

    // هل المستخدم مورد (wholesaler)؟
    function isWholesaler() {
      return signedIn() && me().role == 'wholesaler';
    }

    // هل المستخدم تاجر نشط (active retailer)؟
    function isActiveRetailer() {
      return signedIn() && me().role == 'retailer' && me().status == 'active';
    }

    // هل العملة المدخلة ضمن العملات الثلاث المعتمدة في النظام؟
    function currencyOk(c) {
      return c in ['YER', 'SAR', 'USD'];
    }

    // ─────────────────────────────────────────────
    // invites/{code} — أكواد الدعوة
    // ─────────────────────────────────────────────
    
   match /invites/{code} {

      // قراءة كود محدد بـ get مسموحة للتحقق من الكود أثناء التسجيل
      allow get: if true;

      // [E1] المورد فقط يستطيع list على أكواده لعرضها في شاشة العملاء وتدويرها
      allow list: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid;

      // المورد ينشئ أو يعدّل كوداً يخصّه هو فقط
      allow create, update: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // users/{uid} — مستندات المستخدمين
    // ─────────────────────────────────────────────
    match /users/{uid} {

      // المستخدم يقرأ ملفه الشخصي
      // أو المورد يقرأ مستندات تجّاره (wholesalerId == uid المورد)
      // أو التاجر يقرأ مستند مورده
      allow read: if signedIn()
        && (
          uid == request.auth.uid
          || resource.data.wholesalerId == request.auth.uid
          || uid == me().wholesalerId
        );

      // تسجيل تاجر جديد فقط — بشروط صارمة:
      // 1) المستند يخص نفس المستخدم المسجل
      // 2) الدور retailer فقط (لا يمكن التسجيل كمورد)
      // 3) الحالة pending (لا يمكن التفعيل الذاتي)
      // 4) كود الدعوة موجود في invites ونشط
      // 5) الـ wholesalerId في الطلب يطابق ما في مستند كود الدعوة
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'retailer'
        && request.resource.data.status == 'pending'
        && exists(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode))
        && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.isActive == true
        && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.wholesalerId
             == request.resource.data.wholesalerId;

      // المستخدم يعدّل بياناته الشخصية فقط (لا يمسّ الدور أو المورد أو الحالة)
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['businessName','ownerName','phone','city','address','avatarUrl','updatedAt']);

      // المورد يقبل أو يوقف تاجراً تابعاً له فقط
      // ويعدّل حقلَي status وupdatedAt فقط (لا غير)
      allow update: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid
        && request.resource.data.status in ['active','blocked']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','updatedAt']);

      // لا أحد يحذف مستند مستخدم
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // products/{id} — المنتجات
    // ─────────────────────────────────────────────
    match /products/{id} {
      // المورد يقرأ منتجاته، والتاجر النشط يقرأ فقط منتجات مورده
      allow read: if isWholesaler() && resource.data.wholesalerId == request.auth.uid
                  || isActiveRetailer() && resource.data.wholesalerId == me().wholesalerId;

      // المورد ينشئ منتجاً يخصّه فقط، مع التحقق من أن العملة صحيحة (YER / SAR / USD)
      allow create: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid
        && currencyOk(request.resource.data.currency);

      // المورد يعدّل أو يحذف منتجاته الخاصة فقط
      allow update, delete: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // orders/{id} — الطلبات
    // ─────────────────────────────────────────────
    match /orders/{id} {
      // قراءة الطلب مسموحة للتاجر صاحب الطلب أو المورد الموجه له الطلب
      allow read: if signedIn() && (
        resource.data.retailerId == request.auth.uid
        || resource.data.wholesalerId == request.auth.uid
      );

      // التاجر النشط فقط ينشئ طلباً:
      // 1) retailerId يطابق UID التاجر المسجل
      // 2) wholesalerId يطابق مورد التاجر (me().wholesalerId)
      // 3) الحالة الابتدائية pending حصراً
      allow create: if isActiveRetailer()
        && request.resource.data.retailerId == request.auth.uid
        && request.resource.data.wholesalerId == me().wholesalerId
        && request.resource.data.status == 'pending';

      // تحديثات المورد:
      // 1) pending -> approved (مع paymentType إما credit أو cash)
      // 2) pending -> rejected (مع سبب الرفض)
      // 3) approved -> delivered
      // مع قيد affectedKeys الصارم
      allow update: if isWholesaler()
        && resource.data.wholesalerId == request.auth.uid
        && ((resource.data.status == 'pending' && request.resource.data.status == 'approved'
               && request.resource.data.paymentType in ['credit', 'cash'])
         || (resource.data.status == 'pending' && request.resource.data.status == 'rejected')
         || (resource.data.status == 'approved' && request.resource.data.status == 'delivered'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paymentType', 'updatedAt', 'approvedAt', 'deliveredAt', 'rejectionReason']);

      // التاجر يلغي طلبه فقط إذا كانت حالته pending ويعدل فقط status و updatedAt
      allow update: if signedIn()
        && resource.data.retailerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      // لا يُحذف أي طلب
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // ledger/{id} — دفتر القيود المالية (Task 5.6)
    // ─────────────────────────────────────────────
    match /ledger/{id} {
      // قراءة القيود مسموحة للتاجر أو المورد المعنيين بالقيد حصراً
      allow read: if signedIn() && (
        resource.data.retailerId == request.auth.uid
        || resource.data.wholesalerId == request.auth.uid
      );

      // المورد فقط ينشئ قيداً مالياً لتاجر تابع له حصراً مع تدقيق الحقول
      allow create: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid
        && request.resource.data.retailerId is string
        && request.resource.data.retailerId != ''
        && request.resource.data.type in ['DEBT', 'PAYMENT']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && currencyOk(request.resource.data.currency)
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(db)/documents/users/$(request.resource.data.retailerId)).data.wholesalerId == request.auth.uid;

      // ممنوع نهائياً تعديل أو حذف أي قيد محاسبي (سجل تاريخي غير قابل للتغيير)
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // accounts/{id} — حسابات وأرصدة التجار (Task 5.6)
    // ─────────────────────────────────────────────
    match /accounts/{id} {
      // قراءة الحساب مسموحة للتاجر أو المورد المعنيين بالحساب حصراً
      allow read: if signedIn() && (
        resource.data.retailerId == request.auth.uid
        || resource.data.wholesalerId == request.auth.uid
      );

      // المورد فقط يكتب أو يدمج تحديثات الأرصدة لتجاره التابعين له
      allow write: if isWholesaler()
        && request.resource.data.wholesalerId == request.auth.uid
        && request.resource.data.retailerId is string
        && get(/databases/$(db)/documents/users/$(request.resource.data.retailerId)).data.wholesalerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // قاعدة افتراضية — رفض كل ما لم يُذكر صراحةً
    // (ledger / accounts تُضاف في M4)
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}

